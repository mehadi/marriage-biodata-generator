# Canonical site URL for SEO (sitemap, Open Graph, canonical links).
# Set this in production to your deployed URL.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional — Google Search Console ownership verification (the content value of the
# google-site-verification meta tag). Leave unset if verifying via DNS/GTM instead.
# NEXT_PUBLIC_GSC_VERIFICATION=

# Optional — Bing Webmaster Tools verification code.
# NEXT_PUBLIC_BING_VERIFICATION=

# Optional — Microsoft Clarity project ID. Leave unset to disable Clarity entirely.
# NEXT_PUBLIC_CLARITY_ID=
